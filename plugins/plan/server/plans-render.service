[Unit]
Description=MkDocs dev server for ~/plans (live-reload)

[Service]
Type=simple
WorkingDirectory=%h/.config/plans-server
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=%h/.config/plans-server/venv/bin/mkdocs serve --dev-addr 127.0.0.2:8001 -f %h/.config/plans-server/mkdocs.yml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target

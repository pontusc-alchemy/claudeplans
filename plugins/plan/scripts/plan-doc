#!/usr/bin/env python3
"""Create/lookup/metadata/lint helper for plan documents.

Stdlib only — runs before the render venv exists. The frontmatter contract is
six flat single-line `key: value` pairs; parsed by split-on-first-colon, not
pyyaml. JSON to stdout, diagnostics to stderr, exit 0 / 1 (violation) / 2 (usage).

The docs root defaults to ~/plans/src; override with the PLANS_SRC env var.
"""

import argparse
import datetime
import difflib
import json
import os
import re
import sys
from pathlib import Path

DOCS_ROOT = Path(os.environ.get("PLANS_SRC", Path.home() / "plans" / "src"))
TEMPLATES = Path(__file__).resolve().parent.parent / "templates"
PROJECTS_GLOB = "projects/*/*.md"

TYPES = {"research", "plan"}
STATUSES = {"draft", "active", "done"}
REQUIRED_FIELDS = ["title", "description", "type", "status", "date"]
PILL_CLASSES = {"todo", "doing", "done", "blocked"}
DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9-]*\Z")
PHASE_RE = re.compile(r"^## Phase\s+(\d+)\s*[—-]\s*(.*?)\s*\{#([A-Za-z0-9-]+)\}\s*$")
ANCHOR_RE = re.compile(r"\{#([A-Za-z0-9-]+)\}")
LINK_ANCHOR_RE = re.compile(r"\]\(#([A-Za-z0-9-]+)\)")
PILL_RE = re.compile(r'<span class="pill (\w+)"')
NOTE_RE = re.compile(r'<span class="note">(.*?)</span>')
CHECKBOX_RE = re.compile(r"^\s*- \[([ xX])\]\s*(.*)$")
INLINE_CODE_RE = re.compile(r"`[^`]*`")


def die(msg, code=2):
  print(msg, file=sys.stderr)
  sys.exit(code)


def is_fence(line):
  """True for a Markdown code-fence line (``` or ~~~), allowing indentation."""
  stripped = line.lstrip()
  return stripped.startswith("```") or stripped.startswith("~~~")


def slugify(text):
  s = text.strip().lower()
  s = re.sub(r"[^a-z0-9]+", "-", s)
  return s.strip("-")


def today():
  return datetime.date.today().isoformat()


def parse_frontmatter(text):
  if not text.startswith("---"):
    return {}
  parts = text.split("---", 2)
  if len(parts) < 3:
    return {}
  fm = {}
  for line in parts[1].splitlines():
    line = line.strip()
    if not line or ":" not in line:
      continue
    key, _, value = line.partition(":")
    fm[key.strip()] = strip_quotes(value.strip())
  return fm


def strip_quotes(value):
  if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
    inner = value[1:-1]
    if value[0] == "'":
      inner = inner.replace("''", "'")
    return inner
  return value


def quote_value(value):
  """Single-quote a value when bare YAML would misparse it; else emit as-is.

  The lenient reader (strip_quotes) reverses this, so writes round-trip.
  """
  if "\n" in value or "\r" in value:
    die("frontmatter values are single-line", 2)
  needs_quote = (
    not value
    or value != value.strip()
    or value[0] in "\"'!&*?|>%@`#-[]{},"
    or ": " in value
    or value.endswith(":")
    or "#" in value
  )
  if needs_quote:
    return "'" + value.replace("'", "''") + "'"
  return value


def card(path):
  fm = parse_frontmatter(path.read_text(encoding="utf-8"))
  return {
    "project": path.parent.name,
    "slug": path.stem,
    "path": str(path),
    "title": fm.get("title", ""),
    "description": fm.get("description", ""),
    "type": fm.get("type", ""),
    "status": fm.get("status", ""),
    "date": fm.get("date", ""),
  }


def all_docs():
  return sorted(DOCS_ROOT.glob(PROJECTS_GLOB))


def _ensure_under_root(path):
  resolved = path.resolve()
  root = DOCS_ROOT.resolve()
  if not resolved.is_relative_to(root):
    die(f"path '{resolved}' is outside docs root '{root}'")
  return resolved


def resolve_path(arg):
  p = Path(arg)
  if p.is_file():
    return _ensure_under_root(p)
  matches = [d for d in all_docs() if d.stem == arg]
  if len(matches) == 1:
    return _ensure_under_root(matches[0])
  if len(matches) > 1:
    die(f"ambiguous slug '{arg}': {', '.join(str(m) for m in matches)}")
  die(f"no document matches '{arg}'")


def write_card(path):
  print(json.dumps(card(path)))


def replace_field(text, key, value, path=None):
  parts = text.split("---", 2)
  if len(parts) < 3:
    die(f"'{path}' has no frontmatter block", 1)
  lines = parts[1].splitlines()
  written = f"{key}: {quote_value(value)}"
  out = []
  found = False
  for line in lines:
    stripped = line.strip()
    if stripped and ":" in stripped and stripped.partition(":")[0].strip() == key:
      out.append(written)
      found = True
    else:
      out.append(line)
  if not found:
    out.append(written)
  # Rebuild the block deterministically: drop blank edge lines from the split,
  # then re-emit with a single leading/trailing newline so the closing fence
  # always lands on its own line regardless of how many fields were rewritten.
  while out and not out[0].strip():
    out.pop(0)
  while out and not out[-1].strip():
    out.pop()
  parts[1] = "\n" + "\n".join(out) + "\n"
  return "---".join(parts)


def cmd_new(args):
  if not NAME_RE.match(args.project):
    die(f"project '{args.project}' must match {NAME_RE.pattern}")
  slug = args.slug or slugify(args.title)
  if not slug:
    die("could not derive a slug; pass --slug")
  if not NAME_RE.match(slug):
    die(f"slug '{slug}' must match {NAME_RE.pattern}")
  project_dir = DOCS_ROOT / "projects" / args.project
  target = project_dir / f"{slug}.md"
  _ensure_under_root(target)
  is_new = not project_dir.exists()
  project_dir.mkdir(parents=True, exist_ok=True)
  if is_new:
    print(f"creating new project '{args.project}'", file=sys.stderr)
  if target.exists():
    die(f"'{target}' exists — revise in place, never -v2")
  template = TEMPLATES / f"{args.kind}.md"
  text = template.read_text(encoding="utf-8")
  text = replace_field(text, "title", args.title)
  if args.description:
    text = replace_field(text, "description", args.description)
  text = replace_field(text, "type", args.kind)
  text = replace_field(text, "status", "draft")
  text = replace_field(text, "date", today())
  target.write_text(text, encoding="utf-8")
  print(json.dumps({
    "path": str(target),
    "slug": slug,
    "project": args.project,
    "url": f"http://plans.claude/projects/{args.project}/{slug}.html",
  }))


def cmd_list(args):
  out = []
  for path in all_docs():
    c = card(path)
    if args.project and c["project"] != args.project:
      continue
    if args.status and c["status"] != args.status:
      continue
    if args.type and c["type"] != args.type:
      continue
    out.append(c)
  print(json.dumps(out))


def cmd_resolve(args):
  arg = args.arg
  project_dir = DOCS_ROOT / "projects" / arg
  if project_dir.is_dir():
    docs = [card(p) for p in sorted(project_dir.glob("*.md"))]
    print(json.dumps({"kind": "project", "docs": docs}))
    return
  exact = [card(p) for p in all_docs() if p.stem == arg]
  if len(exact) == 1:
    print(json.dumps({"kind": "doc", "docs": exact}))
    return
  if len(exact) > 1:
    print(json.dumps({"kind": "ambiguous", "docs": exact}))
    return
  substr = [card(p) for p in all_docs() if arg in p.stem]
  if len(substr) == 1:
    print(json.dumps({"kind": "doc", "docs": substr}))
  elif len(substr) > 1:
    print(json.dumps({"kind": "ambiguous", "docs": substr}))
  else:
    print(json.dumps({"kind": "none", "docs": []}))


def cmd_status(args):
  if args.value not in STATUSES:
    die(f"status must be one of {sorted(STATUSES)}")
  path = resolve_path(args.target)
  text = path.read_text(encoding="utf-8")
  text = replace_field(text, "status", args.value, path)
  text = replace_field(text, "date", today(), path)
  path.write_text(text, encoding="utf-8")
  write_card(path)


def cmd_touch(args):
  path = resolve_path(args.target)
  text = path.read_text(encoding="utf-8")
  text = replace_field(text, "date", today(), path)
  path.write_text(text, encoding="utf-8")
  write_card(path)


def parse_heading_attrs(line):
  """Parse a '## ...' heading's trailing attr_list block `{...}`.

  Returns (name, slug_or_None, classes_set). Tokens inside the braces are
  whitespace-separated; `#x` is an id, `.x` is a class, order-independent.
  slug is None when there is no `{...}` block or no `#id` within it.
  """
  m = re.search(r"\{([^}]*)\}\s*$", line)
  if not m:
    return line[3:].strip(), None, set()
  name = line[3:m.start()].strip()
  slug = None
  classes = set()
  for tok in m.group(1).split():
    if tok.startswith("#"):
      slug = tok[1:]
    elif tok.startswith("."):
      classes.add(tok[1:])
  return name, slug, classes


def parse_phases(text):
  lines = text.splitlines()
  # Per-line fence state so fenced phase headings, pills, and checkboxes are
  # ignored (mirrors check_doc's toggle).
  in_fence = []
  fenced = False
  for line in lines:
    if is_fence(line):
      fenced = not fenced
      in_fence.append(True)  # the fence line itself is inside the fence span
    else:
      in_fence.append(fenced)
  # Every out-of-fence '## ' heading bounds a candidate block; the block ends at
  # the NEXT such heading of any kind. A block is a PHASE iff its heading carries
  # an id `{#slug}` AND the `.phase` class. The `.phase` marker is authoritative:
  # other sections (e.g. `## Gaps & decisions {#gaps}`) legitimately carry pills on
  # their items, and legacy `## Phase N` headings lack `.phase` — neither is a phase.
  heading_lines = [
    i for i, line in enumerate(lines)
    if not in_fence[i] and line.startswith("## ")
  ]
  phases = []
  ordinal = 0
  for idx, i in enumerate(heading_lines):
    name, slug, classes = parse_heading_attrs(lines[i])
    if slug is None or "phase" not in classes:
      continue
    end = heading_lines[idx + 1] if idx + 1 < len(heading_lines) else len(lines)
    block_idx = range(i + 1, end)
    # Status is the first pill span anywhere in the block. The `.phase` class on
    # the heading is the authoritative phase marker, so the pill need not be the
    # immediately-following line — some docs put a sentence before the status line.
    pill = None
    note = None
    pill_line = None
    for j in block_idx:
      if in_fence[j]:
        continue
      pm = PILL_RE.search(lines[j])
      if pm:
        pill = pm.group(1)
        pill_line = j + 1
        nm = NOTE_RE.search(lines[j])
        if nm:
          note = nm.group(1)
        break
    if pill is None:
      continue
    tasks = []
    for j in block_idx:
      if in_fence[j]:
        continue
      cm = CHECKBOX_RE.match(lines[j])
      if cm:
        tasks.append({
          "line": j + 1,
          "checked": cm.group(1).lower() == "x",
          "text": cm.group(2).strip(),
        })
    ordinal += 1
    phases.append({
      "ordinal": ordinal,
      "slug": slug,
      "name": name,
      "status": pill,
      "note": note,
      "has_phase_class": "phase" in classes,
      "pill_line": pill_line,
      "tasks": tasks,
    })
  return phases


def phase_report(text):
  """Pure phase summary for a plan body: {current, tally, phases}.

  Consumed by both `cmd_phases` and the render hook, so the tracker never
  re-derives phase state. `text` is the document body (frontmatter optional —
  parse_phases ignores it).
  """
  phases = parse_phases(text)
  current = next((p["slug"] for p in phases if p["status"] != "done"), None)
  tally = {
    "done": sum(1 for p in phases if p["status"] == "done"),
    "total": len(phases),
    "blocked": sum(1 for p in phases if p["status"] == "blocked"),
  }
  out_phases = [
    {
      "ordinal": p["ordinal"],
      "slug": p["slug"],
      "name": p["name"],
      "status": p["status"],
      "note": p["note"],
      "has_phase_class": p["has_phase_class"],
      "tasks": p["tasks"],
    }
    for p in phases
  ]
  return {"current": current, "tally": tally, "phases": out_phases}


def cmd_phases(args):
  path = resolve_path(args.target)
  text = path.read_text(encoding="utf-8")
  fm = parse_frontmatter(text)
  if fm.get("type") != "plan":
    die(f"'{path}' is type: {fm.get('type')!r}, not plan")
  report = phase_report(text)
  if not report["phases"]:
    print(
      "no phase headings parsed — current:null does not mean done",
      file=sys.stderr,
    )
  print(json.dumps(report))


def escape_note(s):
  return s.replace("&", "&amp;").replace("<", "&lt;")


LEGACY_PHASE_RE = re.compile(r"^## Phase\s+\d+")


def cmd_set_phase(args):
  if args.value not in PILL_CLASSES:
    die(f"phase status must be one of {sorted(PILL_CLASSES)}")
  path = resolve_path(args.target)
  text = path.read_text(encoding="utf-8")
  phases = parse_phases(text)
  matches = [p for p in phases if p["slug"] == args.slug]
  if not matches:
    die(f"no phase with slug '{args.slug}'")
  if len(matches) > 1:
    die(f"duplicate phase slug '{args.slug}'")
  ph = matches[0]
  # A preserved note (--note omitted) is already-escaped bytes on disk — write it
  # back verbatim. A note from --note is literal user text and must be escaped.
  # Re-escaping a preserved note would grow &amp; -> &amp;amp; on every run.
  if args.note is None:
    note = ph["note"]
    note_html = note
  else:
    note = args.note
    note_html = escape_note(note)
  trailing_newline = text.endswith("\n")
  lines = text.splitlines()
  orig = lines[ph["pill_line"] - 1]
  indent = orig[: len(orig) - len(orig.lstrip())]
  status_line = f'{indent}<span class="pill {args.value}">{args.value}</span>'
  if note:
    status_line += f' <span class="note">{note_html}</span>'
  lines[ph["pill_line"] - 1] = status_line
  text = "\n".join(lines) + ("\n" if trailing_newline else "")
  text = replace_field(text, "date", today(), path)

  # Auto-flip the doc to done when every phase is done, none blocked, and no
  # legacy numeric phase headings remain.
  reparsed = parse_phases(text)
  in_fence = False
  has_legacy = False
  for line in text.splitlines():
    if is_fence(line):
      in_fence = not in_fence
      continue
    if in_fence:
      continue
    if LEGACY_PHASE_RE.match(line):
      has_legacy = True
      break
  auto_flipped = False
  if (
    reparsed
    and all(p["status"] == "done" for p in reparsed)
    and not any(p["status"] == "blocked" for p in reparsed)
    and not has_legacy
  ):
    text = replace_field(text, "status", "done", path)
    auto_flipped = True

  path.write_text(text, encoding="utf-8")
  print(json.dumps({
    "path": str(path),
    "slug": args.slug,
    "status": args.value,
    "note": note if note else None,
    "auto_flipped": auto_flipped,
  }))
  errors, warnings, checklist = check_doc(path)
  for line, msg in errors:
    print(f"{path}:{line}: error: {msg}", file=sys.stderr)
  for line, msg in warnings:
    print(f"{path}:{line}: warning: {msg}", file=sys.stderr)
  if checklist:
    print(f"{path}: restructure checklist:", file=sys.stderr)
    for item in checklist:
      print(f"  - {item}", file=sys.stderr)


def _advisory_check(path):
  """Run check_doc and print errors/warnings/checklist to stderr; never exits."""
  errors, warnings, checklist = check_doc(path)
  for line, msg in errors:
    print(f"{path}:{line}: error: {msg}", file=sys.stderr)
  for line, msg in warnings:
    print(f"{path}:{line}: warning: {msg}", file=sys.stderr)
  if checklist:
    print(f"{path}: restructure checklist:", file=sys.stderr)
    for item in checklist:
      print(f"  - {item}", file=sys.stderr)


def cmd_task(args):
  path = resolve_path(args.target)
  text = path.read_text(encoding="utf-8")
  phases = parse_phases(text)
  matches = [p for p in phases if p["slug"] == args.slug]
  if not matches:
    die(f"no phase with slug '{args.slug}'")
  if len(matches) > 1:
    die(f"duplicate phase slug '{args.slug}'")
  ph = matches[0]
  tasks = ph["tasks"]
  if args.selector.isdigit():
    idx = int(args.selector)
    if idx < 1 or idx > len(tasks):
      die(f"task index {idx} out of range ({len(tasks)} tasks)")
    task = tasks[idx - 1]
  else:
    needle = args.selector.lower()
    hits = [t for t in tasks if needle in t["text"].lower()]
    if not hits:
      die(f"no task matching '{args.selector}'")
    if len(hits) > 1:
      die(f"ambiguous task selector '{args.selector}' (matches {len(hits)})")
    task = hits[0]
  want_checked = bool(args.check)
  trailing_newline = text.endswith("\n")
  lines = text.splitlines()
  orig = lines[task["line"] - 1]
  cm = CHECKBOX_RE.match(orig)
  indent = orig[: len(orig) - len(orig.lstrip())]
  box = "x" if want_checked else " "
  lines[task["line"] - 1] = f"{indent}- [{box}] {cm.group(2)}"
  text = "\n".join(lines) + ("\n" if trailing_newline else "")
  text = replace_field(text, "date", today(), path)
  path.write_text(text, encoding="utf-8")
  print(json.dumps({
    "path": str(path),
    "slug": args.slug,
    "task_line": task["line"],
    "checked": want_checked,
    "text": cm.group(2).strip(),
  }))
  _advisory_check(path)


def cmd_add_phase(args):
  path = resolve_path(args.target)
  text = path.read_text(encoding="utf-8")
  phases = parse_phases(text)
  slug = args.slug or slugify(args.name)
  if not NAME_RE.match(slug):
    die(f"slug '{slug}' must match {NAME_RE.pattern}")
  if any(p["slug"] == slug for p in phases):
    die(f"duplicate phase slug '{slug}'")

  block = f"## {args.name} {{#{slug} .phase}}\n\n<span class=\"pill todo\">todo</span>"

  trailing_newline = text.endswith("\n")
  lines = text.splitlines()
  # Out-of-fence '## ' heading line indices.
  in_fence = False
  heading_lines = []
  for i, line in enumerate(lines):
    if is_fence(line):
      in_fence = not in_fence
      continue
    if in_fence:
      continue
    if line.startswith("## "):
      heading_lines.append(i)

  if args.after is not None:
    ref = next((p for p in phases if p["slug"] == args.after), None)
    if ref is None:
      die(f"no phase with slug '{args.after}'")
    ref_heading = next(
      i for i, line in enumerate(lines)
      if line.startswith("## ") and parse_heading_attrs(line)[1] == args.after
    )
  else:
    if not phases:
      die("no phases to anchor insertion; pass --after <slug>")
    last_slug = phases[-1]["slug"]
    ref_heading = next(
      i for i, line in enumerate(lines)
      if line.startswith("## ") and parse_heading_attrs(line)[1] == last_slug
    )

  # Insertion point: first out-of-fence '## ' heading strictly after the
  # reference heading; else end-of-file.
  following = next((h for h in heading_lines if h > ref_heading), None)
  if following is None:
    insert_at = len(lines)
  else:
    insert_at = following

  before = lines[:insert_at]
  after_lines = lines[insert_at:]
  # Trim trailing blanks from `before` and leading blanks from the new block's
  # neighbours so we emit exactly one blank line on each side.
  while before and not before[-1].strip():
    before.pop()
  while after_lines and not after_lines[0].strip():
    after_lines.pop(0)

  new_lines = list(before)
  if before:
    new_lines.append("")
  new_lines.extend(block.splitlines())
  if after_lines:
    new_lines.append("")
    new_lines.extend(after_lines)

  text = "\n".join(new_lines) + ("\n" if trailing_newline else "")
  text = replace_field(text, "date", today(), path)
  path.write_text(text, encoding="utf-8")

  reparsed = parse_phases(text)
  ordinal = next((p["ordinal"] for p in reparsed if p["slug"] == slug), None)
  print(json.dumps({
    "path": str(path),
    "slug": slug,
    "name": args.name,
    "after": args.after,
    "ordinal": ordinal,
  }))
  _advisory_check(path)


LEGACY_PILLS = {"ok", "gap", "partial"}
NUMERIC_PHASE_RE = re.compile(r"^## Phase\s+\d+\b")
# The legacy status tracker is specifically a `| Phase | Anchor | Pill | … |`
# header — require an Anchor or Pill column so genuine `| Phase | Check |`-style
# tables (e.g. a verification checklist) are not flagged.
MANUAL_TABLE_RE = re.compile(r"^\|\s*Phase\s*\|\s*(Anchor|Pill)\s*\|", re.IGNORECASE)
PROSE_PHASE_RE = re.compile(r"\bPhase\s+\d+\b")
PANDOC_SPAN_RE = re.compile(r"\]\{\.[A-Za-z]")


def check_doc(path):
  """Severity-tiered lint: (errors, warnings, checklist).

  Only frontmatter validity is fatal. Everything else is a warning; legacy-format
  warnings also append a deduped restructure-checklist item (line may be 0).
  """
  errors = []
  warnings = []
  checklist = []

  def add_checklist(item):
    if item not in checklist:
      checklist.append(item)

  text = path.read_text(encoding="utf-8")
  fm = parse_frontmatter(text)
  for field in REQUIRED_FIELDS:
    if not fm.get(field):
      errors.append((1, f"missing required frontmatter field '{field}'"))
  if fm.get("type") and fm["type"] not in TYPES:
    errors.append((1, f"type '{fm['type']}' not in {sorted(TYPES)}"))
  if fm.get("status") and fm["status"] not in STATUSES:
    errors.append((1, f"status '{fm['status']}' not in {sorted(STATUSES)}"))
  if fm.get("date") and not DATE_RE.match(fm["date"]):
    errors.append((1, f"date '{fm['date']}' is not YYYY-MM-DD"))

  body_start = 0
  if text.startswith("---"):
    parts = text.split("---", 2)
    if len(parts) >= 3:
      body_start = len(parts[0].splitlines()) + len(parts[1].splitlines()) + 2
      # Each frontmatter line must be blank or a `key: value` pair; a stray line
      # (e.g. from an injected newline) is silently dropped by the lenient
      # reader but breaks gen_index's pyyaml — flag it here.
      fm_base = len(parts[0].splitlines()) + 1
      for k, fm_line in enumerate(parts[1].splitlines()):
        if fm_line.strip() and ":" not in fm_line:
          errors.append((fm_base + k + 1, "frontmatter line is not 'key: value'"))

  defined_anchors = set()
  link_targets = []  # (line, id)
  has_plan_structure = False  # set only by `.phase` headings (not decision pills)

  lines = text.splitlines()
  in_fence = False
  for i, line in enumerate(lines):
    n = i + 1
    stripped = line.lstrip()
    if stripped.startswith("```") or stripped.startswith("~~~"):
      in_fence = not in_fence
      continue
    if in_fence:
      continue
    indent = len(line) - len(stripped)
    # Strip inline-code spans so documented examples (e.g. `[text]{.class}`,
    # `--note`, a `gap` pill) don't trip the prose/pill/render-trap detectors.
    scrubbed = INLINE_CODE_RE.sub("", line)

    for am in ANCHOR_RE.finditer(scrubbed):
      defined_anchors.add(am.group(1))
    for lm in LINK_ANCHOR_RE.finditer(scrubbed):
      link_targets.append((n, lm.group(1)))

    if i >= body_start and indent <= 3 and stripped.startswith("# "):
      warnings.append((n, "body '# ' h1 — the page h1 comes from frontmatter title"))

    for pm in PILL_RE.finditer(scrubbed):
      cls = pm.group(1)
      if cls in LEGACY_PILLS:
        warnings.append((
          n,
          f"legacy pill enum '{cls}' — migrate to {{blocked,doing,done,todo}}",
        ))
        add_checklist(
          "replace legacy pills (ok/gap/partial) with the "
          "todo|doing|done|blocked enum"
        )
      elif cls not in PILL_CLASSES:
        warnings.append((n, f"unknown pill class '{cls}'"))

    if line.startswith("## "):
      _name, slug, classes = parse_heading_attrs(line)
      if slug is not None:
        # A heading id is written as an attr_list `{#slug .class}`, which
        # ANCHOR_RE (anchored on `}`) does not match — register it explicitly so
        # links to anchored headings aren't flagged dead.
        defined_anchors.add(slug)
      # Only a `.phase`-classed heading is plan structure; a plain `{#slug}`
      # section anchor is normal in a research doc.
      if "phase" in classes:
        has_plan_structure = True

    if NUMERIC_PHASE_RE.match(line):
      warnings.append((
        n,
        "legacy numeric phase heading — migrate to '## <name> {#slug .phase}'",
      ))
      add_checklist(
        "convert '## Phase N — …' headings to '## <name> {#slug .phase}' "
        "+ a machine-managed pill line"
      )

    if MANUAL_TABLE_RE.match(line):
      warnings.append((
        n,
        "manual phase/status table — the tracker is now machine-rendered",
      ))
      add_checklist(
        "delete the manual phase/status table; the render hook generates it"
      )

    # Literal 'Phase N' in prose: skip heading lines and existing slug links.
    if (
      not stripped.startswith("## ")
      and PROSE_PHASE_RE.search(scrubbed)
      and "](#" not in scrubbed
    ):
      warnings.append((
        n,
        "literal 'Phase N' in prose — use a slug link [name](#slug)",
      ))

    if PANDOC_SPAN_RE.search(scrubbed):
      warnings.append((
        n,
        "Pandoc-style [text]{.class} does not render — use a raw "
        '<span class="…">',
      ))
      add_checklist(
        "replace Pandoc [text]{.class} spans with raw <span> tags"
      )

    # Skip table rows: `| --- |` separators legitimately contain '---'.
    if not stripped.startswith("|") and (" -- " in scrubbed or " --- " in scrubbed):
      warnings.append((
        n,
        "literal '--'/'---' in prose — use an em-dash —",
      ))

  if "checklist" in defined_anchors:
    add_checklist("rename the {#checklist} anchor to {#gaps}")

  for n, target in link_targets:
    if target not in defined_anchors:
      warnings.append((n, f"dead anchor link '#{target}' — no matching {{#{target}}}"))

  if fm.get("type") == "plan":
    plan_phases = parse_phases(text)
    # A done plan with no phase sections is a historical record, not something to
    # track — only nudge active/draft plans toward the phase structure.
    if not plan_phases and fm.get("status") != "done":
      warnings.append((1, "type: plan with no phases"))
    for ph in plan_phases:
      if ph["status"] is None and not ph["tasks"]:
        warnings.append((
          1,
          f"phase {ph['ordinal']} '{ph['name']}' has neither a pill nor tasks — status undeterminable",
        ))
  elif fm.get("type") and has_plan_structure:
    warnings.append((1, "research doc carries phase structure (.phase headings)"))

  return errors, warnings, checklist


LEGACY_PILL_MAP = {"ok": "done", "gap": "todo", "partial": "doing"}
FIX_PILL_RE = re.compile(r'<span class="pill (ok|gap|partial)">(.*?)</span>')
FIX_PANDOC_SPAN_RE = re.compile(r"\[([^\]]*)\]\{\.([A-Za-z][\w-]*)\}")


def _sub_outside_code(line, transform):
  """Apply `transform` (str->str) only to non-inline-code segments of `line`.

  Inline-code (`...`) spans, located via INLINE_CODE_RE, are left untouched so
  documented examples inside backticks survive verbatim. Reassembled in order.
  """
  out = []
  pos = 0
  for m in INLINE_CODE_RE.finditer(line):
    out.append(transform(line[pos:m.start()]))
    out.append(m.group(0))
    pos = m.end()
  out.append(transform(line[pos:]))
  return "".join(out)


def _fix_pills(segment):
  def repl(m):
    new_cls = LEGACY_PILL_MAP[m.group(1)]
    inner = m.group(2)
    if inner == m.group(1):
      inner = new_cls
    return f'<span class="pill {new_cls}">{inner}</span>'

  return FIX_PILL_RE.sub(repl, segment)


def _fix_checklist_anchor(segment):
  return segment.replace("{#checklist}", "{#gaps}").replace(
    "](#checklist)", "](#gaps)"
  )


def _fix_pandoc_span(segment):
  return FIX_PANDOC_SPAN_RE.sub(r'<span class="\2">\1</span>', segment)


def _fix_prose_dashes(segment):
  return segment.replace(" --- ", " — ").replace(" -- ", " — ")


def compute_fixed_text(text):
  """Apply mechanical, prose-safe autofixes line-by-line. Pure, no IO.

  Substitutions touch only out-of-fence lines and only the non-inline-code
  segments of each line. Structural migration (numeric phase headings, manual
  tables) is intentionally left alone.
  """
  trailing_newline = text.endswith("\n")
  lines = text.splitlines()
  in_fence = False
  out = []
  for line in lines:
    if is_fence(line):
      in_fence = not in_fence
      out.append(line)
      continue
    if in_fence:
      out.append(line)
      continue
    new = _sub_outside_code(line, _fix_pills)
    new = _sub_outside_code(new, _fix_checklist_anchor)
    new = _sub_outside_code(new, _fix_pandoc_span)
    stripped = new.strip()
    if not stripped.startswith("|") and stripped != "---":
      new = _sub_outside_code(new, _fix_prose_dashes)
    out.append(new)
  return "\n".join(out) + ("\n" if trailing_newline else "")


def cmd_fix(args):
  path = resolve_path(args.target)
  text = path.read_text(encoding="utf-8")
  new_text = compute_fixed_text(text)
  changed = new_text != text
  if not args.write:
    if not changed:
      print("no fixes needed", file=sys.stderr)
      sys.exit(0)
    diff = difflib.unified_diff(
      text.splitlines(keepends=True),
      new_text.splitlines(keepends=True),
      fromfile=str(path),
      tofile=str(path),
    )
    sys.stdout.writelines(diff)
    sys.exit(0)
  fixes = sum(
    1
    for a, b in zip(text.splitlines(), new_text.splitlines())
    if a != b
  )
  if changed:
    new_text = replace_field(new_text, "date", today(), path)
    path.write_text(new_text, encoding="utf-8")
  print(json.dumps({"path": str(path), "changed": changed, "fixes": fixes}))
  _advisory_check(path)


def cmd_check(args):
  if args.all:
    targets = all_docs()
  else:
    targets = [resolve_path(a) for a in args.targets]
  if not targets:
    die("nothing to check; pass slugs/paths or --all")
  had_error = False
  for path in targets:
    errors, warnings, checklist = check_doc(path)
    for line, msg in errors:
      print(f"{path}:{line}: error: {msg}", file=sys.stderr)
      had_error = True
    for line, msg in warnings:
      print(f"{path}:{line}: warning: {msg}", file=sys.stderr)
    if checklist:
      print(f"{path}: restructure checklist:", file=sys.stderr)
      for item in checklist:
        print(f"  - {item}", file=sys.stderr)
  sys.exit(1 if had_error else 0)


def build_parser():
  p = argparse.ArgumentParser(prog="plan-doc")
  sub = p.add_subparsers(dest="cmd", required=True)

  n = sub.add_parser("new")
  n.add_argument("project")
  n.add_argument("kind", choices=["research", "plan"])
  n.add_argument("title")
  n.add_argument("--slug")
  n.add_argument("--description")
  n.set_defaults(func=cmd_new)

  l = sub.add_parser("list")
  l.add_argument("project", nargs="?")
  l.add_argument("--status", choices=sorted(STATUSES))
  l.add_argument("--type", choices=sorted(TYPES))
  l.set_defaults(func=cmd_list)

  r = sub.add_parser("resolve")
  r.add_argument("arg")
  r.set_defaults(func=cmd_resolve)

  s = sub.add_parser("status")
  s.add_argument("target")
  s.add_argument("value")
  s.set_defaults(func=cmd_status)

  t = sub.add_parser("touch")
  t.add_argument("target")
  t.set_defaults(func=cmd_touch)

  ph = sub.add_parser("phases")
  ph.add_argument("target")
  ph.set_defaults(func=cmd_phases)

  sp = sub.add_parser("set-phase")
  sp.add_argument("target")
  sp.add_argument("slug")
  sp.add_argument("value")
  sp.add_argument("--note", default=None)
  sp.set_defaults(func=cmd_set_phase)

  tk = sub.add_parser("task")
  tk.add_argument("target")
  tk.add_argument("slug")
  tk.add_argument("selector")
  tkg = tk.add_mutually_exclusive_group(required=True)
  tkg.add_argument("--check", action="store_true")
  tkg.add_argument("--uncheck", action="store_true")
  tk.set_defaults(func=cmd_task)

  ap = sub.add_parser("add-phase")
  ap.add_argument("target")
  ap.add_argument("name")
  ap.add_argument("--after")
  ap.add_argument("--slug")
  ap.set_defaults(func=cmd_add_phase)

  c = sub.add_parser("check")
  c.add_argument("targets", nargs="*")
  c.add_argument("--all", action="store_true")
  c.set_defaults(func=cmd_check)

  fx = sub.add_parser("fix")
  fx.add_argument("target")
  fx.add_argument("--write", action="store_true")
  fx.set_defaults(func=cmd_fix)

  return p


def main():
  args = build_parser().parse_args()
  args.func(args)


if __name__ == "__main__":
  main()

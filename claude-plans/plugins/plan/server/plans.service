[Unit]
Description=Always-on local plan site (Caddy over ~/plans)
Documentation=https://caddyserver.com/docs/
After=network.target

[Service]
Type=notify
User=pontusc
Group=pontusc
Environment=XDG_DATA_HOME=/var/lib/plans-caddy
StateDirectory=plans-caddy
ExecStart=/usr/bin/caddy run --config /home/pontusc/.config/plans-server/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /home/pontusc/.config/plans-server/Caddyfile --adapter caddyfile --force
Restart=on-failure
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
